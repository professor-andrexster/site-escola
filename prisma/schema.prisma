  usuarios_curso_avaliadores_user_idTousuarios       usuarios  @relation("curso_avaliadores_user_idTousuarios", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "curso_avaliadores_user_fkey")

  @@unique([curso_id, user_id], map: "curso_avaliadores_curso_user_key")
  @@index([convidado_por], map: "curso_avaliadores_convidou_fkey")
  @@index([user_id], map: "curso_avaliadores_user_idx")
}

model modulos {
  id             String           @id @default(dbgenerated("(uuid())")) @db.Char(36)
  nome           String           @db.VarChar(80)
  slug           String           @unique @db.VarChar(100)
  descricao      String?          @db.Text
  nivel          String           @db.VarChar(20)
  ordem          Int              @default(0)
  carga_horaria  Int?
  capa_url       String?          @db.VarChar(300)
  publicado      Boolean          @default(false)
  criado_em      DateTime?        @default(now()) @db.DateTime(0)
  atualizado_em  DateTime?        @default(now()) @db.DateTime(0)
  certificados   certificados[]
  curso_desafios curso_desafios[]
  cursos         cursos[]
}
