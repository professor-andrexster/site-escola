# vhost da escola — ETAPA 1, só HTTP.
#
# De propósito sem os blocos 443: o certificado ainda não existe, e um
# `ssl_certificate` apontando para arquivo inexistente faz `nginx -t` falhar —
# o que impediria o reload e deixaria os outros sites deste servidor sem
# poder recarregar configuração até alguém perceber.
#
# O Certbot completa este arquivo sozinho, acrescentando o bloco 443 e o
# redirecionamento, depois que o DNS apontar para cá:
#
#   certbot --nginx -d escolaestadualdrjoaoberaldo.com \
#                   -d www.escolaestadualdrjoaoberaldo.com
#
# Instalação:
#   cp deploy/escola.nginx /etc/nginx/sites-available/escola
#   ln -s /etc/nginx/sites-available/escola /etc/nginx/sites-enabled/
#   nginx -t            # OBRIGATÓRIO — se falhar, remova o link e pare
#   systemctl reload nginx   # reload, nunca restart

server {
    listen 80;
    listen [::]:80;
    server_name escolaestadualdrjoaoberaldo.com www.escolaestadualdrjoaoberaldo.com;

    # Webroot do ACME, no mesmo lugar que os demais vhosts deste servidor usam.
    # Precisa vir antes das outras regras para o Certbot conseguir validar.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Limite de envio: o maior aceito pela aplicação é 25 MB (entrega de
    # desafio). Sem esta linha o nginx corta em 1 MB e o erro chega na tela
    # como "falha ao enviar", sem dizer por quê.
    client_max_body_size 30M;

    # Entrega de desafio e arquivo herdado do Supabase são de tipo livre:
    # baixam, nunca abrem no navegador. Sem isto, um HTML enviado como entrega
    # roda no domínio da escola, com acesso aos cookies de quem abrir.
    # Vem antes do bloco geral porque regex ganha de prefixo.
    location ~ ^/arquivos/((?:desafios|legado)/.+)$ {
        # O caminho capturado ENTRA no alias. Dentro de um location com
        # expressao regular, `alias` sem a captura faz o nginx mapear a
        # requisicao para o diretorio e responder 301 com barra no fim — o
        # arquivo nunca chega. Visto em producao na conferencia.
        alias /var/www/escola/data/uploads/$1;
        add_header Content-Disposition "attachment";
        add_header X-Content-Type-Options "nosniff";
        access_log off;
        expires 1y;
    }

    # Demais arquivos enviados pelo site, servidos direto do disco. A rota
    # /arquivos da aplicação continua existindo como reserva, e as URLs
    # gravadas no banco são as mesmas nos dois caminhos.
    location /arquivos/ {
        alias /var/www/escola/data/uploads/;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri @app;
    }

    location @app {
        proxy_pass http://127.0.0.1:3004;
    }

    location / {
        proxy_pass http://127.0.0.1:3004;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # A aplicação lê o IP daqui para o limite de tentativas de login.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
