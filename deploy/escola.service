# Serviço da aplicação da escola. Espelha o padrão dos outros serviços Next
# que já rodam neste VPS.
#
# Instalação (na virada, como root):
#   cp deploy/escola.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now escola
#
# Porta 3004. A 3003 parecia livre pela documentação, mas está ocupada desde
# 02/08 por um contêiner Docker (nexialabs-crm) que o CLAUDE.md ainda descreve
# como projeto só do desktop. 3000, 3001 e 3002 são dos outros três serviços.

[Unit]
Description=E.E. Dr. Joao Beraldo — site e painel
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=escola
Group=escola
WorkingDirectory=/srv/escola/app
EnvironmentFile=/srv/escola/app/.env
Environment=NODE_ENV=production
Environment=PORT=3004
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# O processo escreve em dois lugares: a pasta de uploads e o cache do Next.
#
# O `.next` faltava aqui, e o efeito não era óbvio: as páginas com `revalidate`
# continuavam servindo, porque o Next mantém o cache em memória — mas ele tenta
# gravar em disco a cada revalidação, apanha um EROFS e recomeça. Eram 535 erros
# no journal em vinte minutos, e revalidação repetida batendo no banco à toa.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/escola/data/uploads /srv/escola/app/.next

[Install]
WantedBy=multi-user.target
