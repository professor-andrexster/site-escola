NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Envio de email transacional (convite de bibliotecaria), via resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=biblioteca@escolaestadualdrjoaoberaldo.com

# Chave gratuita do Google AI Studio (https://aistudio.google.com/apikey)
# usada para gerar perguntas de quiz com IA
GEMINI_API_KEY=your-gemini-api-key

# Botão "Chamados" (widget do Bussola) no painel, só para a equipe.
# CHAMADOS_CHAVE identifica este sistema perante o Bussola; CHAMADOS_SEGREDO
# assina a sessão do dia (HMAC-SHA256). Sem as duas, o widget não aparece.
CHAMADOS_CHAVE=escola-jb
CHAMADOS_SEGREDO=your-chamados-secret
